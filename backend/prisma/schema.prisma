// Prisma schema for the Jira-clone project
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum TicketType {
  BUG
  TASK
  STORY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    ProjectMember[]
  assignedTickets Ticket[]       @relation("TicketAssignee")
  comments       Comment[]
  ownedProjects  Project[]       @relation("ProjectOwner")

  @@map("users")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique // e.g. "ENG" for ticket codes like ENG-123
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  board   Board?
  tickets Ticket[]
  labels  Label[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // a user has exactly one role per project
  @@index([userId])
  @@map("project_members")
}

model Board {
  id        String   @id @default(uuid())
  projectId String   @unique // one board per project for now
  name      String   @default("Main Board")
  createdAt DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns Column[]

  @@map("boards")
}

model Column {
  id      String @id @default(uuid())
  boardId String
  name    String
  order   Int // used to sort columns left-to-right

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([boardId])
  @@map("columns")
}

model Ticket {
  id          String     @id @default(uuid())
  projectId   String
  columnId    String
  title       String
  description String?
  type        TicketType @default(TASK)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  order       Int // position within its column, use gaps (e.g. 1000, 2000) for cheap reordering
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments Comment[]
  labels   TicketLabel[]

  @@index([projectId])
  @@index([columnId])
  @@index([assigneeId])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("comments")
}

model Label {
  id        String @id @default(uuid())
  projectId String
  name      String
  color     String @default("#999999")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets TicketLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

// Explicit join table for the many-to-many Ticket <-> Label relation.
// Modeled explicitly (rather than an implicit Prisma m:n) in case you want
// to add fields like `addedAt` or `addedBy` later without a migration rewrite.
model TicketLabel {
  ticketId String
  labelId  String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
  @@map("ticket_labels")
}
