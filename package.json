{
  "name": "jira-clone",
  "private": true,
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern backend/src frontend",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"backend/src/**/*.ts\" \"frontend/**/*.{ts,tsx}\"",
    "format": "prettier --no-error-on-unmatched-pattern --write \"backend/src/**/*.ts\" \"frontend/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.43.0"
  }
}